        args.active = 'Submitted';
        update_svg();
    });

    $('#btn_accept').on('click', function () {
        args.active = 'Accepted';
        update_svg();
    });

    $('#btn_reject').on('click', function () {
        args.active = 'Rejected';
        update_svg();
    });


    // initialization
    update_svg();
    d3.select('#main-render').append(() => create_gui());

