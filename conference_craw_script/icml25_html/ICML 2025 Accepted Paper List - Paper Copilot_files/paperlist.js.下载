    function renderZoomableBarChart() {

        let bin2d = [];
        let xLabel = '';
        let yLabel = '';

        // filter keys based on the active status
        keys_to_render = [];
        keys_rej = ['Reject', 'Desk Reject', 'Withdraw'];
        if (args.active === 'Submitted') {
            keys_to_render = meta.status;
        } else if (args.active === 'Accepted') {
            keys_to_render = meta.status.filter(d => !keys_rej.includes(d));
        } else if (args.active === 'Rejected') {
            keys_to_render = keys_rej;
        }

        function get_bin2d_from_meta(metadata, zDomain) {
            ret = [];
            metadata.split(';').forEach((d, i) => {
                // if (i > args.bar.num_bars) return;
                words = d.split(':');
                if (words.length <= 1) {
                    console.log('Error: ', words);
                    return;
                } else if (words.length <= 2) {
                    ret.push({ letter: words[0], all: parseInt(words[1]), id: i });
                    args.bar.summary_only = true; // if words.length <= 2, then it is a summary
                }
                else if (words.length <= 3) {
                    if (args.bar.summary_only) {
                        ret.push({ letter: words[0], all: parseInt(words[1]), id: i });
                    } else {
                        frequencs = words[2].split(',');
                        // bin = { letter: words[0] + ': ' + words[1], id: i };
                        bin = { letter: words[0], id: i };
                        for (let j = 0; j < frequencs.length; j++) {
                            if (zDomain.includes(meta.status[j])) {
                                bin[meta.status[j]] = parseInt(frequencs[j]);
                            } else {
                                bin[meta.status[j]] = 0;
                            }
                        }
                        ret.push(bin);
                    }
                }
            });
            return ret;
        }

        // update svg
        yLabel = "↑ Frequency (zoomable and pannable chart)"
        bin2d = get_bin2d_from_meta(meta.xaxis[args.xaxis][0], keys_to_render);
        notes = '';
        if (args.xaxis === 'authors') {
            notes = meta.xaxis[args.xaxis][0] === '' ? '(People with same name are counted together, split in the future analysis.)' : '';
        }
        else if (args.xaxis === 'authors_first') {
            notes = meta.xaxis[args.xaxis][0] === '' ? '(People with same name are counted together, split in the future analysis.)' : '';
        }
        else if (args.xaxis === 'authors_last') {
            notes = meta.xaxis[args.xaxis][0] === '' ? '(People with same name are counted together, split in the future analysis.)' : '';
        }
        xLabel = args.xaxis + " with the most, " + args.active + ', ' + " papers " + notes + " →";

        const svg = ZoomableStackedBarChart(bin2d, {
            width: args.width,
            height: args.height,
            xLabel: xLabel,
            yLabel: yLabel,
            show_frequency: args.bar.show_frequency,
            show_labels: args.bar.show_labels,
            keys: args.bar.summary_only ? ['all'] : keys_to_render,
            num_bars: args.bar.num_bars,
            enableAnimation: args.animate,
        })

        // update svg
        d3.select('#main-render').select('svg').remove();
        d3.select('#main-render').append(() => svg.node());
        createGearButton(svg, { onClick: onclick_btn_setting });
    }

    /**
     * Handles the click event for the btn_setting button.
     * Toggles the display of the control panel.
     */
    function onclick_btn_setting() {
        // hide or shown the control panel
        gui = document.getElementById('gui');
        if (gui.style.display === 'none') {
            gui.style.display = 'block';
            args.display = 'block';
        } else {
            gui.style.display = 'none';
            args.display = 'none';
        }
    }

    /**
     * Resets the values of `args` to match the initial values in `args_init`.
     * The `active` and `chart` properties are not reset.
     * Calls the `update_svg` function after resetting the values.
     */
    function onclick_btn_reset() {

        // copy value of args_init to args recursively
        let sync = (a, b) => {
            for (let k in a) {
                if (typeof a[k] === 'object') {
                    sync(a[k], b[k]);
                } else if (k === 'active' || k === 'chart') {
                    continue;
                } else {
                    a[k] = b[k];
                }
            }
        }
        sync(args, args_init);

        // reset all args recursively but not the active property
        update_svg();
    }
    
    // Attach a click handler for each entry in the array
    Object.keys(meta.xaxis).forEach((key) => {
        $(`#btn_${key}`).on('click', function () {
            args.xaxis = key;
            update_svg();
        });
    });

    async function onclick_btn_download() {
        // Function to convert SVG to Canvas
        function svgToCanvas(svgElement) {
            const svgString = new XMLSerializer().serializeToString(svgElement);
            const canvas = document.createElement("canvas");
            const context = canvas.getContext("2d");

            const image = new Image();
            const svgBlob = new Blob([svgString], { type: "image/svg+xml;charset=utf-8" });
            const url = URL.createObjectURL(svgBlob);

            return new Promise((resolve) => {
                image.onload = function () {
                    canvas.width = image.width;
                    canvas.height = image.height;
                    context.drawImage(image, 0, 0);
                    URL.revokeObjectURL(url);
                    resolve(canvas);
                };
                image.src = url;
            });
        }

        // Function to download Canvas as JPG or PNG
        function downloadCanvas(canvas, filename, format) {
            const link = document.createElement('a');
            link.download = filename;
            link.href = canvas.toDataURL(`image/${format}`);
            link.click();
        }

        // Button click event
        const filename = `${ajaxmeta.conf}${ajaxmeta.year}_${ajaxmeta.track}_${args.active}_${args.chart}_${args.xaxis}`;
        const format = args.download.format.toLowerCase();
        const svgElement = document.querySelector("#main-render svg");
        const canvas = await svgToCanvas(svgElement);
        downloadCanvas(canvas, `${filename}.${format}`, format);
    }


    $('#btn_setting').on('click', onclick_btn_setting);
    $(document).keydown(function (e) {
        if (e.which == 'S'.charCodeAt(0)) {
            onclick_btn_setting();
        } else if (e.ctrlKey && e.which == 'R'.charCodeAt(0)) {
            onclick_btn_reset();
        } else if (e.ctrlKey && e.which == 'D'.charCodeAt(0)) {
            onclick_btn_download();
        }
    });

