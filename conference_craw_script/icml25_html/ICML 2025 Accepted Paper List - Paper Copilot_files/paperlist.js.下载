    let args = JSON.parse(JSON.stringify(args_init)); // copy by value
    args.reset = function () { }; // reset function is not copied by value
    args.toggle = function () { };
    args.download.run = function () { };

    function update_svg() {
        renderZoomableBarChart();
    }

    function create_gui() {

        gui = new lil.GUI({
            autoPlace: false,
            // closeFolders: true, 
            width: args.gui_width,
