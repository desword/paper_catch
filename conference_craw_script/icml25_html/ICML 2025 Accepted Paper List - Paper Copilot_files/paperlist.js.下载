        // gui settings
        gui_width: 250,
        display: 'none',
        // meta settings
        toggle: function () { },
        reset: function () { },
        active: 'Accepted', // the active status
        chart: 'Bar',
        animate: true,
        // chart settings
        width: 1400,
        height: window.innerWidth / window.innerHeight > 1 ? 500 : 1000,
        xaxis: Object.keys(meta.xaxis)[0],
