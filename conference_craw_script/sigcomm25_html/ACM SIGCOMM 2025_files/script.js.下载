// load HTML file into an element
function loadHTML(elementId, filePath, callback) {
    const element = document.getElementById(elementId);
    if (element) {
        fetch(filePath)
            .then(response => {
                if (!response.ok) {
                    throw new Error("Error loading: " + filePath);
                }
                return response.text();
            })
            .then(data => {
                element.innerHTML = data;
                if (callback) callback();
            })
            .catch(error => {
                console.error(error);
            });
    }
}

// Toggle menu
function toggleMenu() {
    const menu = document.querySelector('.menu');
    if (menu) {
        menu.classList.toggle('visible');
    }
}

// Toggle submenu
function toggleSubmenu() {
    document.querySelectorAll('.menu li').forEach(item => {
        item.addEventListener('click', function(event) {
            event.stopPropagation();
            const submenu = this.querySelector('.submenu');
            const arrow = this.querySelector('.submenu-arrow');
            if (submenu) {
                this.classList.toggle('active');
                // Show/hide submenu
                if (submenu.style.maxHeight) {
                    submenu.style.maxHeight = null;
                } else {
                    submenu.style.maxHeight = submenu.scrollHeight + "px";
                }
                // Rotate arrow
                if (arrow) {
                    arrow.classList.toggle('rotated');
                }
            }
        });
    });
}

// Load the header, footer and make sure everything is ready before showing content
document.addEventListener("DOMContentLoaded", function() {

    // Load the header and footer
    loadHTML('header', 'https://conferences.sigcomm.org/sigcomm/2025/header.html', function() {
        toggleSubmenu();
    });

    loadHTML('footer', 'https://conferences.sigcomm.org/sigcomm/2025/footer.html', function() {
        // Once everything is loaded, show the page by making the body visible
        document.documentElement.style.visibility = 'visible';
    });

    // scroll to top button
    const scrollToTopBtn = document.getElementById("scrollToTopBtn");
    window.onscroll = function() {
        if (document.body.scrollTop > 300 || document.documentElement.scrollTop > 300) {
            scrollToTopBtn.classList.add("show");
        } else {
            scrollToTopBtn.classList.remove("show");
        }
    };
    scrollToTopBtn.addEventListener("click", function() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    });

});

// Toggle abstract visibility on paper title click
document.querySelectorAll('.paper-table').forEach(paperSection => {
    paperSection.querySelectorAll('.paper-title')?.forEach(button => {
        button.addEventListener('click', function () {
            const currentRow = this.closest('tr');
            const abstractRow = currentRow.nextElementSibling;
            if (abstractRow && abstractRow.classList.contains('abstract-row')) {
                const isVisible = abstractRow.style.display === 'table-row';
                abstractRow.style.display = isVisible ? 'none' : 'table-row';
            }
        });
    });
});

// Tabs (for SIGCOMM-like menu)
function openTab(evt, tabId) {
    // Hide all tab contents
    document.querySelectorAll('.tab-content').forEach(tab => {
        tab.classList.remove('active');
    });

    // Remove "active" from all tab buttons
    document.querySelectorAll('.tab-menu button').forEach(btn => {
        btn.classList.remove('active');
    });

    // Show selected tab
    document.getElementById(tabId)?.classList.add('active');
    evt.currentTarget.classList.add('active');
}

document.documentElement.classList.add('visible');
